---
/** Visible breadcrumb trail. The matching BreadcrumbList JSON-LD is added by PageLayout/BlogLayout. */
import type { Crumb } from '../utils/schema';
interface Props { crumbs: Crumb[]; }
const { crumbs } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {crumbs.map((c, i) =>
      i === crumbs.length - 1
        ? <li><span aria-current="page">{c.name}</span></li>
        : <li><a href={c.href}>{c.name}</a></li>
    )}
  </ol>
</nav>
