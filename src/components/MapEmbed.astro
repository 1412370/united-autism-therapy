---
/**
 * Google Map of the Westminster center, shown directly (no click needed).
 * loading="lazy" keeps it off the critical path: the browser only fetches the
 * iframe when it is about to scroll into view. The address and a directions
 * link stay visible even if the map is blocked.
 */
import { BUSINESS, mapsUrl, fullAddress } from '../data/site';
const embedSrc = `https://www.google.com/maps?q=${encodeURIComponent(BUSINESS.mapsQuery)}&output=embed`;
---
<div class="map-embed">
  <div class="map-facade">
    <iframe
      src={embedSrc}
      title="Map showing United Autism Therapy in Westminster, CA"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
  </div>
  <p class="map-embed__meta">
    <strong>United Autism Therapy</strong> · {fullAddress}
    · <a href={mapsUrl} target="_blank" rel="noopener">Get directions</a>
  </p>
</div>
