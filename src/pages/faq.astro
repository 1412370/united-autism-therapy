---
import PageLayout from '../layouts/PageLayout.astro';
import FAQ from '../components/FAQ.astro';
import { FAQ_GROUPS } from '../data/faqs';
import { INTEGRATIONS } from '../data/site';
import { faqSchema } from '../utils/schema';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'FAQ', href: '/faq/' }];
const all = FAQ_GROUPS.flatMap((g) => g.items);
---
<PageLayout
  title="In-Home ABA Therapy FAQ for Parents"
  description="Answers about ABA and in-home ABA therapy, BCBAs and RBTs, insurance and Medi-Cal, and getting started with United Autism Therapy in Westminster, CA."
  h1="Frequently Asked Questions"
  eyebrow="FAQ"
  lead="Short, clear answers to the questions parents ask us most. Don’t see yours? Call us — we’re happy to help."
  crumbs={crumbs}
  schema={INTEGRATIONS.faqSchema ? [faqSchema(all)] : []}
>
  <section class="section">
    <div class="wrap-narrow">
      <nav aria-label="FAQ topics" class="mt-1">
        <ul class="tag-list" style="gap:.6rem">
          {FAQ_GROUPS.map((g) => <li style="background:none;padding:0"><a class="chip" href={`#${g.id}`}>{g.title}</a></li>)}
        </ul>
      </nav>
      {FAQ_GROUPS.map((g) => (
        <div class="faq-group mt-2" id={g.id}>
          <FAQ items={g.items} title={g.title} id={`faq-${g.id}`} />
        </div>
      ))}
    </div>
  </section>
</PageLayout>
