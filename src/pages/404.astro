---
import PageLayout from '../layouts/PageLayout.astro';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Page not found', href: '/404/' }];
---
<PageLayout title="Page Not Found" description="The page you were looking for could not be found." h1="Sorry, we couldn’t find that page" crumbs={crumbs} noindex showHeroCta={false}
  lead="The page may have moved. Try one of these instead:">
  <section class="section"><div class="wrap-narrow prose">
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/services/">Our services</a></li>
      <li><a href="/blog/">Parent resources</a></li>
      <li><a href="/contact/">Contact us</a></li>
    </ul>
  </div></section>
</PageLayout>
