---
import PageLayout from '../../layouts/PageLayout.astro';
import { LOCATIONS } from '../../data/locations';
import { BUSINESS, telHref, fullAddress, openHoursText, closedDaysText } from '../../data/site';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Locations', href: '/locations/' }];
---
<PageLayout
  title="Locations & Service Area"
  description="United Autism Therapy is based in Westminster, CA, with in-home ABA for families in Orange, Riverside, San Diego, San Bernardino and Santa Clara Counties."
  h1="Our Location & Service Area"
  eyebrow="Locations"
  lead="One location in Westminster, and in-home ABA across five California counties, launching in Orange County first."
  crumbs={crumbs}
>
  <section class="section">
    <div class="wrap grid grid-2">
      {LOCATIONS.map((l) => (
        <article class="card card--link">
          <h2 style="font-size:var(--fs-600)"><a class="stretched" href={`/locations/${l.slug}/`}>{l.name} center</a></h2>
          <p class="mt-1">{l.address.street}<br />{l.address.city}, {l.address.region} {l.address.postalCode}</p>
          <p class="mt-1">{l.phone}</p>
          <span class="card__more" aria-hidden="true">Hours &amp; directions →</span>
        </article>
      ))}
      <article class="card">
        <h2 style="font-size:var(--fs-600)">Counties we serve (in-home ABA)</h2>
        <ul class="counties">{BUSINESS.counties.map((c) => <li>{c}, CA</li>)}</ul>
        <p class="mt-1">We bring ABA therapy to families’ homes in these counties. <a href="/locations/orange-county-ca/">See our Orange County service area</a>, or <a href={telHref}>call {BUSINESS.phone}</a> to confirm availability at your address.</p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>How our service area is rolling out</h2>
      <p>United Autism Therapy serves families in five California counties: Orange, Riverside, San Diego, San Bernardino and Santa Clara. In-home ABA therapy is launching in Orange County first, so in-home availability in the other four counties may depend on your address.</p>
      <p>Our Westminster center is the place for center-based ABA sessions, which families can attend at {BUSINESS.address.street}. If you live outside Orange County, call us before you plan around in-home services, and we will tell you what is available for your address.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Finding us and getting in touch</h2>
      <p>Our Westminster location is at {fullAddress}. You can reach us at <a href={telHref}>{BUSINESS.phone}</a>, and our hours are {openHoursText}{closedDaysText ? `, with ${closedDaysText} closed` : ''}. To learn more about the families we support and our approach, visit our <a href="/about/">about page</a>, or send us a message through the <a href="/contact/">contact page</a>.</p>
      <p>If you are looking for regional center information in Orange County, our guide to <a href="/blog/how-to-request-rcoc-intake-for-autism/">requesting regional center intake for autism</a> explains the steps. RCOC is a separate agency from United Autism Therapy.</p>
    </div>
  </section>
</PageLayout>
