---
/**
 * Blog article layout. The article body is rendered to static HTML at build
 * time — nothing about the main content depends on client-side JavaScript.
 */
import { Image, getImage } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import Layout from './Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import CTABand from '../components/CTABand.astro';
import { SITE, INTEGRATIONS, BUSINESS, telHref, absoluteUrl } from '../data/site';
import { AUTHORS } from '../data/authors';
import { getCategory } from '../data/categories';
import { getService } from '../data/services';
import { breadcrumbSchema, faqSchema, blogPostingSchema } from '../utils/schema';
import { formatDate, readingTime, wordCount, type Post } from '../utils/posts';

interface Props { post: Post; headings: MarkdownHeading[]; related: Post[]; }
const { post, headings, related } = Astro.props;
const d = post.data;
const url = absoluteUrl(`/blog/${post.id}/`);
const author = AUTHORS[d.author];
const category = getCategory(d.category);
const service = d.relatedService ? getService(d.relatedService) : null;
const h1 = d.h1 ?? d.title;
const toc = headings.filter((h) => h.depth === 2);

// Social share image: a 1200×630 JPEG generated from the featured image.
const og = await getImage({ src: d.featuredImage, width: 1200, height: 630, format: 'jpg', quality: 80 });

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog/' },
  { name: category.name, href: `/blog/category/${category.slug}/` },
  { name: h1, href: `/blog/${post.id}/` },
];

const schema = [
  blogPostingSchema({
    title: h1,
    description: d.summary ?? d.description,
    url,
    image: absoluteUrl(og.src),
    datePublished: d.date,
    dateModified: d.updatedDate,
    authorName: author.name,
    authorUrl: author.url,
    authorType: author.type,
    section: category.name,
    keywords: [d.primaryKeyword, ...d.secondaryKeywords],
    wordCount: wordCount(post.body),
    aboutUrl: service ? absoluteUrl(`/services/${service.slug}/`) : undefined,
    citations: d.references.map((r) => r.url),
  }),
  breadcrumbSchema(crumbs),
  ...(d.faqs.length && INTEGRATIONS.faqSchema ? [faqSchema(d.faqs)] : []),
];
---
<Layout
  title={d.title}
  description={d.description}
  canonical={d.canonical ?? `/blog/${post.id}/`}
  image={og.src}
  imageAlt={d.alt}
  type="article"
  noindex={d.noindex}
  publishedTime={d.date}
  modifiedTime={d.updatedDate}
  schema={schema}
>
  <div class="wrap">
    <div class="article-layout">
      <article>
        <header class="article-header">
          <Breadcrumbs crumbs={crumbs} />
          <p class="mt-1"><a class="chip" href={`/blog/category/${category.slug}/`}>{category.name}</a></p>
          <h1>{h1}</h1>
          <div class="article-meta">
            <span>By <a href={author.url}>{author.name}</a></span>
            {d.reviewedBy && <span>Reviewed by {d.reviewedBy}</span>}
            <span>Published <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time></span>
            {d.updatedDate && d.updatedDate.valueOf() !== d.date.valueOf() && (
              <span>Updated <time datetime={d.updatedDate.toISOString()}>{formatDate(d.updatedDate)}</time></span>
            )}
            <span>{readingTime(post.body)} min read</span>
          </div>
          <figure class="article-hero">
            <Image
              src={d.featuredImage}
              alt={d.alt}
              widths={[480, 800, 1200]}
              sizes="(min-width: 1100px) 760px, 94vw"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              format="webp"
            />
          </figure>
        </header>

        {d.summary && (
          <div class="quick-answer mt-2">
            <p class="quick-answer__label">Quick answer</p>
            <p>{d.summary}</p>
          </div>
        )}

        <div class="prose mt-2">
          <slot />
        </div>

        {d.faqs.length > 0 && (
          <div class="mt-3"><FAQ items={d.faqs} title="Frequently asked questions" /></div>
        )}

        {d.references.length > 0 && (
          <section class="references mt-3" aria-labelledby="refs-title">
            <h2 id="refs-title" style="font-size:1.25rem">References</h2>
            <ol>
              {d.references.map((r) => (
                <li><a href={r.url} target="_blank" rel="noopener">{r.title}</a> — {r.publisher}</li>
              ))}
            </ol>
          </section>
        )}

        <div class="card mt-3 author-box">
          <span class="author-box__avatar"><Icon name="user" /></span>
          <div>
            <p><strong>{author.name}</strong></p>
            <p class="muted" style="font-size:.95rem">{author.bio}</p>
          </div>
        </div>

        <p class="disclaimer mt-2">
          This article is for general education and is not medical advice. Every child is different — please talk with your
          child’s pediatrician or a qualified professional about your child’s needs. <a href="/medical-disclaimer/">Read our medical disclaimer</a>.
        </p>

        {d.tags.length > 0 && (
          <div class="mt-2">
            <h2 class="sr-only">Topics</h2>
            <ul class="tag-list">{d.tags.map((t) => <li>{t}</li>)}</ul>
          </div>
        )}
      </article>

      <aside class="sidebar" aria-label="Article tools">
        {toc.length > 2 && (
          <nav class="card toc" aria-labelledby="toc-title">
            <h2 id="toc-title">On this page</h2>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
        <div class="card cta-card">
          <h2>Have questions about your child?</h2>
          <p>Talk with our Westminster team. Free consultation, no obligation.</p>
          <a class="btn btn--light" href="/contact/">Request a Consultation</a>
          <p style="text-align:center;margin-top:.75rem">or call <a href={telHref}>{BUSINESS.phone}</a></p>
        </div>
        {service && (
          <div class="card">
            <h2>Related service</h2>
            <p class="mt-1"><a href={`/services/${service.slug}/`}><strong>{service.name}</strong></a></p>
            <p class="muted" style="font-size:.95rem">{service.summary}</p>
          </div>
        )}
      </aside>
    </div>
  </div>

  <section class="section section--sand">
    <div class="wrap">
      <RelatedPosts posts={related} title="Keep reading" intro={`More from ${SITE.name} on ${category.name.toLowerCase()} and related topics.`} />
    </div>
  </section>

  <CTABand />
</Layout>
